// Generated by lsc from invariants.ts
// lsc options: string-semantics=javascript-utf16

type Unknown(==, 0)

function NatToString(n: nat): string
  decreases n
{
  var digit := ('0' as int + n % 10) as char;
  if n < 10 then [digit]
  else NatToString(n / 10) + [digit]
}

lemma NatToStringIsInjective(a: nat, b: nat)
  requires NatToString(a) == NatToString(b)
  ensures a == b
  decreases a + b
{
  var text := NatToString(a);
  var digitA := ('0' as int + a % 10) as char;
  var digitB := ('0' as int + b % 10) as char;
  assert |NatToString(a)| >= 1 && |NatToString(b)| >= 1;
  assert text[|text| - 1] == digitA == digitB;
  assert a % 10 == b % 10;
  if a >= 10 && b >= 10 {
    assert text[..|text| - 1] == NatToString(a / 10) == NatToString(b / 10);
    NatToStringIsInjective(a / 10, b / 10);
  } else {
    assert (a < 10) == (b < 10);
  }
  assert a == (a / 10) * 10 + a % 10;
  assert b == (b / 10) * 10 + b % 10;
}

function IntToString(n: int): string
{
  if n < 0 then "-" + NatToString(-n) else NatToString(n)
}

datatype RenderedTokens = RenderedTokens(sql: string, params: seq<Unknown>)

datatype SqlToken = text(text: string) | bind(value: Unknown)

function projectionAlias(index: int): string
  requires (0 <= index)
  requires (index <= 9007199254740991)
{
  ("__eqb_" + IntToString(index))
}

lemma projectionAlias_ensures(index: int)
  requires (0 <= index)
  requires (index <= 9007199254740991)
  ensures forall other: int :: ((0 <= other) ==> (other <= 9007199254740991) ==> (other != index) ==> (projectionAlias(index) != projectionAlias(other)))
{
  forall other: int | 0 <= other <= 9007199254740991 && other != index
    ensures projectionAlias(index) != projectionAlias(other)
  {
    if projectionAlias(index) == projectionAlias(other) {
      assert projectionAlias(index)[6..] == NatToString(index) == NatToString(other);
      NatToStringIsInjective(index, other);
    }
  }
}

function supportsClause(dialect: string, clause: string): bool
{
  if ((clause == "insertReturning") || (clause == "deleteReturning")) then
    (((dialect == "pg") || (dialect == "sqlite")) || (dialect == "mariadb"))
  else
    (((clause == "fullJoin") || (clause == "updateReturning")) && ((dialect == "pg") || (dialect == "sqlite")))
}

lemma supportsClause_ensures(dialect: string, clause: string)
  ensures (supportsClause(dialect, clause) == ((((dialect == "pg") || (dialect == "sqlite")) || ((dialect == "mariadb") && ((clause == "insertReturning") || (clause == "deleteReturning")))) && ((((clause == "fullJoin") || (clause == "insertReturning")) || (clause == "updateReturning")) || (clause == "deleteReturning"))))
{
}

ghost function BindValues(tokens: seq<SqlToken>): seq<Unknown>
{
  if |tokens| == 0 then []
  else
    var prefix := tokens[..|tokens| - 1];
    match tokens[|tokens| - 1]
      case bind(value) => BindValues(prefix) + [value]
      case text(_) => BindValues(prefix)
}

ghost function RenderSql(tokens: seq<SqlToken>, numbered: bool): string
{
  if |tokens| == 0 then ""
  else
    var prefix := tokens[..|tokens| - 1];
    RenderSql(prefix, numbered) +
      (match tokens[|tokens| - 1]
        case bind(_) => if numbered then "$" + NatToString(|BindValues(prefix)| + 1) else "?"
        case text(chunk) => chunk)
}

method renderTokens(tokens: seq<SqlToken>, numbered: bool) returns (res: RenderedTokens)
  ensures (|res.params| <= |tokens|)
  ensures res.params == BindValues(tokens)
  ensures res.sql == RenderSql(tokens, numbered)
{
  var params: seq<Unknown> := [];
  var sql := "";
  var i_token_idx := 0;
  while i_token_idx < |tokens|
    invariant (i_token_idx <= |tokens|)
    invariant |params| <= i_token_idx
    invariant params == BindValues(tokens[..i_token_idx])
    invariant sql == RenderSql(tokens[..i_token_idx], numbered)
  {
    assert tokens[..i_token_idx + 1][..i_token_idx] == tokens[..i_token_idx];
    assert tokens[..i_token_idx + 1][i_token_idx] == tokens[i_token_idx];
    var token := tokens[i_token_idx];
    match token {
      case bind(i_token_value) =>
        params := (params + [i_token_value]);
        sql := (sql + (if numbered then ("$" + NatToString(|params|)) else "?"));
      case text(i_token_text) =>
        sql := (sql + i_token_text);
    }
    i_token_idx := i_token_idx + 1;
  }
  assert tokens[..|tokens|] == tokens;
  var rendered := RenderedTokens(sql, params);
  return rendered;
}

ghost predicate HasOnlyPairedDelimiters(body: string, delimiter: string)
  requires |delimiter| == 1
  decreases |body|
{
  |body| == 0 ||
    (if body[|body| - 1..] == delimiter then
      |body| >= 2 && body[|body| - 2..] == delimiter + delimiter &&
        HasOnlyPairedDelimiters(body[..|body| - 2], delimiter)
    else HasOnlyPairedDelimiters(body[..|body| - 1], delimiter))
}

method quoteWithDoubledDelimiter(value: string, delimiter: string) returns (res: string)
  requires (|delimiter| == 1)
  ensures (|res| >= |delimiter| && res[..|delimiter|] == delimiter)
  ensures (|res| >= |delimiter| && res[|res|-|delimiter|..] == delimiter)
  ensures ((|value| + 2) <= |res|)
  ensures (|res| <= ((|value| * 2) + 2))
  ensures HasOnlyPairedDelimiters(res[1..|res| - 1], delimiter)
{
  var escaped := delimiter;
  var index := 0;
  while (index < |value|)
    invariant 0 <= index <= |value|
    invariant index + 1 <= |escaped| <= index * 2 + 1
    invariant escaped[..1] == delimiter
    invariant HasOnlyPairedDelimiters(escaped[1..], delimiter)
  {
    var character := value[index..(index + 1)];
    ghost var before := escaped[1..];
    escaped := (escaped + (if (character == delimiter) then (delimiter + delimiter) else character));
    assert escaped[1..] == before + (if character == delimiter then delimiter + delimiter else character);
    assert HasOnlyPairedDelimiters(escaped[1..], delimiter);
    index := (index + 1);
  }
  return (escaped + delimiter);
}
