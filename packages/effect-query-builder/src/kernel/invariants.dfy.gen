type Unknown(==, 0)

function NatToString(n: nat): string
  decreases n
{
  var digit := ('0' as int + n % 10) as char;
  if n < 10 then [digit]
  else NatToString(n / 10) + [digit]
}

function IntToString(n: int): string
{
  if n < 0 then "-" + NatToString(-n) else NatToString(n)
}

datatype RenderedTokens = RenderedTokens(sql: string, params: seq<Unknown>)

datatype SqlToken = text(text: string) | bind(value: Unknown)

function projectionAlias(index: int): string
  requires (0 <= index)
  requires (index <= 9007199254740991)
{
  ("__eqb_" + IntToString(index))
}

lemma projectionAlias_ensures(index: int)
  requires (0 <= index)
  requires (index <= 9007199254740991)
  ensures forall other: int :: ((0 <= other) ==> (other <= 9007199254740991) ==> (other != index) ==> (projectionAlias(index) != projectionAlias(other)))
{
}

function supportsClause(dialect: string, clause: string): bool
{
  if ((clause == "insertReturning") || (clause == "deleteReturning")) then
    (((dialect == "pg") || (dialect == "sqlite")) || (dialect == "mariadb"))
  else
    (((clause == "fullJoin") || (clause == "updateReturning")) && ((dialect == "pg") || (dialect == "sqlite")))
}

lemma supportsClause_ensures(dialect: string, clause: string)
  ensures (supportsClause(dialect, clause) == ((((dialect == "pg") || (dialect == "sqlite")) || ((dialect == "mariadb") && ((clause == "insertReturning") || (clause == "deleteReturning")))) && ((((clause == "fullJoin") || (clause == "insertReturning")) || (clause == "updateReturning")) || (clause == "deleteReturning"))))
{
}

method renderTokens(tokens: seq<SqlToken>, numbered: bool) returns (res: RenderedTokens)
  ensures (|res.params| <= |tokens|)
{
  var params: seq<Unknown> := [];
  var sql := "";
  var i_token_idx := 0;
  while i_token_idx < |tokens|
    invariant (i_token_idx <= |tokens|)
  {
    var token := tokens[i_token_idx];
    match token {
      case bind(i_token_value) =>
        params := (params + [i_token_value]);
        sql := (sql + (if numbered then ("$" + NatToString(|params|)) else "?"));
      case text(i_token_text) =>
        sql := (sql + i_token_text);
    }
    i_token_idx := i_token_idx + 1;
  }
  var rendered := RenderedTokens(sql, params);
  return rendered;
}

method quoteWithDoubledDelimiter(value: string, delimiter: string) returns (res: string)
  requires (|delimiter| == 1)
  ensures (|res| >= |delimiter| && res[..|delimiter|] == delimiter)
  ensures (|res| >= |delimiter| && res[|res|-|delimiter|..] == delimiter)
  ensures ((|value| + 2) <= |res|)
  ensures (|res| <= ((|value| * 2) + 2))
{
  var escaped := delimiter;
  var index := 0;
  while (index < |value|)
  {
    var character := value[index..(index + 1)];
    escaped := (escaped + (if (character == delimiter) then (delimiter + delimiter) else character));
    index := (index + 1);
  }
  return (escaped + delimiter);
}
